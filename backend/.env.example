# Copy to backend/.env — never commit .env
DETECTIF_API_KEY=your-detectifai-api-key-here
DETECTIFAI_BASE_URL=https://platform.detectif.ai
# Internal token the Next.js server sends to FastAPI (change before deploying)
GHOSTKEY_API_TOKEN=change-me
# DetectifAI speaker used for the demo voiceprint (live scenario E / Anita's synthetic policy)
GHOSTKEY_DEMO_SPEAKER_ID=cust-zira-rao-7d3e
GHOSTKEY_MAX_AUDIO_MB=25
GHOSTKEY_MAX_IMAGE_MB=8
GHOSTKEY_CASE_RETENTION_DAYS=7
GHOSTKEY_DB=sqlite:///./ghostkey.db
# "Latest in Downloads" picker: 1 = on (local demo). Set 0 before exposing the app publicly.
GHOSTKEY_LOCAL_DOWNLOADS=1
# GHOSTKEY_DOWNLOADS_DIR=C:/Users/you/Downloads
